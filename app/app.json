{
  "expo": {
    "name": "Trackbench",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.trackbench"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.trackbench",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ELEVATION_GAINED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.POST_PROMOTED_NOTIFICATIONS",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Trackbench uses your location to record the route, distance and pace of a run, even with the screen off.",
          "locationWhenInUsePermission": "Trackbench uses your location to record the route, distance and pace of a run.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "react-native-notify-kit",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-web-browser",
      "expo-audio",
      "expo-splash-screen",
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "trackbench",
    "extra": {
      "eas": {
        "projectId": "6e00e1ad-5e6d-4d04-87dd-c4c8937c233e"
      }
    },
    "owner": "nicholas-cox"
  }
}
